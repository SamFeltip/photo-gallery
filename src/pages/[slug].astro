---
export const prerender = false;

import "@fancyapps/ui/dist/fancybox/fancybox.css";
import { getEntry } from "astro:content";
import MyImage from "~/components/MyImage.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { R2CollectionClient } from "~/lib/r2CollectionClient";

const { slug } = Astro.params;

// No product found
if (!slug) {
  return new Response(null, {
    status: 400,
    statusText: "Invalid request",
  });
}

const gallery = await getEntry("galleries", slug);

if (!gallery) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const groupNames: string[] = gallery.data.groups.map((g) => g.name);

const client = new R2CollectionClient({
  accountId: Astro.locals.runtime.env.R2_ACCOUNT_ID as string,
  bucket: Astro.locals.runtime.env.R2_BUCKET_NAME as string,
  accessKeyId: Astro.locals.runtime.env.R2_ACCESS_KEY_ID as string,
  secretAccessKey: Astro.locals.runtime.env.R2_SECRET_ACCESS_KEY as string,
  publicUrl: Astro.locals.runtime.env.R2_PUBLIC_URL as string,
});

let collectionItem;

try {
  collectionItem = await client.getItemBySlug(slug, groupNames);
} catch (e) {
  return new Response(null, {
    status: 404,
    statusText: "couldn't find",
  });
}

if (!collectionItem) {
  return new Response(null, {
    status: 404,
    statusText: "couldn't find",
  });
}

console.log({ imgGroups: collectionItem.data.imgGroups });
---

<BaseLayout
  title={collectionItem.data.title}
  description=`${slug} photos.`
  image={{ alt: slug, src: gallery?.data.previewImg }}
>
  {!gallery && <h1>gallery not exist!</h1>}
  <main>
    <section>
      <h1
        style="margin-bottom: 0.25rem; font-size: 1.5rem; text-transform: capitalize;"
      >
        <a href="/" style="text-decoration:none; color:inherit;">
          {gallery?.data.name}
        </a>
      </h1>
      {
        gallery?.data.description && (
          <p style="margin-bottom: 0.5rem; ">{gallery?.data.description}</p>
        )
      }
    </section>

    {
      gallery?.data.groups.length > 0 &&
        gallery?.data.groups.map((group) => (
          <section style="margin-bottom: 1rem;">
            {group.title && (
              <h2 style="margin-bottom: 0.25rem; font-size: 1.2rem; text-transform: capitalize; font-family: Unbounded;">
                {group.title}
              </h2>
            )}

            {group.description && (
              <p style="margin-bottom: 0.5rem; ">{group.description}</p>
            )}
            <div class="justified-gallery">
              {collectionItem.data.imgGroups[group.name].map((galleryItem) => {
                return (
                  <a
                    style={`--width: ${galleryItem.width}; --height: ${galleryItem.height};`}
                    href={galleryItem.url}
                    target="_blank"
                    data-fancybox="gallery"
                  >
                    <MyImage
                      src={galleryItem.url}
                      alt={galleryItem.key}
                      width={galleryItem.width}
                      height={galleryItem.height}
                    />
                  </a>
                );
              })}
            </div>
          </section>
        ))
    }

    <section class="justified-gallery" id="photoswipe">
      {
        gallery?.data.groups.length == 0 &&
          collectionItem.data.galleryCollection.map((galleryItem) => {
            return (
              <a
                style={`--width: ${galleryItem.width}; --height: ${galleryItem.height};`}
                href={galleryItem.url}
                target="_blank"
                data-fancybox="gallery"
              >
                <MyImage
                  src={galleryItem.url}
                  alt={galleryItem.key}
                  width={galleryItem.width / 5}
                  height={galleryItem.height / 5}
                />
              </a>
            );
          })
      }
    </section>

    <script>
      import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

      Fancybox.bind("[data-fancybox]", {
        theme: "auto",
        mainStyle: {
          "--f-button-width": "44px",
          "--f-button-height": "44px",
          "--f-button-border-radius": "50%",
          "--f-toolbar-padding": "16px",
        },
        Carousel: {
          Arrows: false,
          Toolbar: {
            display: {
              left: [],
              middle: [],
              right: ["close"],
            },
          },
          transition: "slide",
        },
      });
    </script>

    <style>
      main {
        --padding: max(2.5vw, 12px);
        padding: var(--padding);
      }

      .justified-gallery {
        --space: clamp(12px, 1.25vw, 6px);
        --min-height: clamp(200px, 20vw, 400px);

        display: flex;
        flex-wrap: wrap;
        gap: var(--space);

        a {
          flex-grow: calc(var(--width) * (100000 / var(--height)));
          flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
          aspect-ratio: var(--width) / var(--height);
          overflow: hidden;
          opacity: 1;
          transition: all 0.05s ease-in-out;
        }

        a img {
          display: block;
          object-fit: cover;
          height: 100%;
          width: 100%;
        }

        a:focus-visible {
          outline: 3px solid var(--outline);
          outline-offset: 2px;
          transform: scale(1.05);
          z-index: 1;
          border-radius: 2px;
          box-shadow: 0 2px 4px 2px rgba(0, 0, 0, 0.1);
        }

        a.hidden {
          transition: opacity 0.4s ease-in-out;
          opacity: 0;
        }

        &::after {
          content: " ";
          flex-grow: 1000000000;
        }
      }
    </style>
  </main></BaseLayout
>
