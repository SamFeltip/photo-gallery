---
export const prerender = true;
import { CldImage } from "astro-cloudinary";

import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const { slug } = Astro.params;

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");
  // const galleryCollection = await getCollection("galleryCollections");

  const cloudinaryImages = await getCollection("cloudinaryImages");

  const galleryItems = galleries.map((gallery) => {
    console.log({ gallery: gallery, groups: gallery.data.groups });
    const groupNames: string[] = gallery.data.groups.map((g) => g.name);

    const imgGroups: Record<string, CollectionEntry<"cloudinaryImages">[]> =
      Object.fromEntries(groupNames.map((k) => [k, []]));

    // get valid images
    const imgs = cloudinaryImages.filter(
      (col) => (col.data as any).asset_folder?.indexOf(gallery.id) !== -1
    );

    // load images into image groups
    imgs.forEach((item) => {
      for (let groupName of groupNames) {
        console.log({ groupName });
        if (
          item.data.display_name &&
          item.data.display_name.indexOf(`_${groupName}_`) > -1
        ) {
          imgGroups[groupName].push(item);
        }
      }
    });

    // sort img groups
    Object.keys(imgGroups).forEach((g) => {
      imgGroups[g].sort(
        (a, b) =>
          a.data.display_name?.localeCompare(b.data.display_name ?? "") ?? -1
      );
    });

    return {
      params: { slug: gallery.id },
      props: {
        gallery,
        galleryGroups: imgGroups,
        galleryCollection: cloudinaryImages
          .filter(
            (col) => (col.data as any).asset_folder?.indexOf(gallery.id) !== -1
          )
          .toSorted(
            (a, b) =>
              a.data.display_name?.localeCompare(b.data.display_name ?? "") ??
              -1
          ),
      },
    };
  });

  return galleryItems;
}

const { gallery, galleryCollection, galleryGroups } = Astro.props;

function toTitleCase(str: string) {
  return str.replace(/\b\w/g, (char) => char.toUpperCase());
}
---

<BaseLayout
  title={toTitleCase(slug)}
  description=`${slug} photos.`
  image={{ alt: slug, src: gallery.data.previewImg }}
>
  <main>
    <section>
      <h1
        style="margin-bottom: 0.25rem; font-size: 1.5rem; text-transform: capitalize;"
      >
        {gallery.data.name}
      </h1>
      {
        gallery.data.description && (
          <p style="margin-bottom: 0.5rem; ">{gallery.data.description}</p>
        )
      }
    </section>

    <!-- when photos are seperated into groups -->
    {
      gallery.data.groups.length > 0 &&
        gallery.data.groups.map((group) => (
          <section style="margin-bottom: 1rem;">
            <h2 style="margin-bottom: 0.25rem; font-size: 1.2rem; text-transform: capitalize; font-family: Unbounded;">
              {group.title}
            </h2>
            <p style="margin-bottom: 0.5rem; ">{group.description}</p>

            <div class="justified-gallery">
              {galleryGroups[group.name].map((galleryItem, index) => {
                const image = galleryItem.data;
                return (
                  <a
                    style={`--width: ${image.width}; --height: ${image.height};`}
                    href={galleryItem.data.url}
                    target="_blank"
                    data-fancybox="gallery"
                  >
                    <CldImage
                      src={galleryItem.data.url}
                      format="webp"
                      loading="lazy"
                    />
                  </a>
                );
              })}
            </div>
          </section>
        ))
    }

    <!-- when there are no groups -->
    <section class="justified-gallery" id="photoswipe">
      {
        gallery.data.groups.length == 0 &&
          galleryCollection.map((galleryItem, index) => {
            const image = galleryItem.data;
            return (
              <a
                style={`--width: ${image.width}; --height: ${image.height};`}
                href={galleryItem.data.url}
                target="_blank"
                data-fancybox="gallery"
              >
                <CldImage
                  src={galleryItem.data.url}
                  format="webp"
                  loading="lazy"
                />
              </a>
            );
          })
      }
    </section>
  </main>

  <script>
    import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

    Fancybox.bind("[data-fancybox]", {
      theme: "auto",
      mainStyle: {
        "--f-button-width": "44px",
        "--f-button-height": "44px",
        "--f-button-border-radius": "50%",
        "--f-toolbar-padding": "16px",
      },
      Carousel: {
        Arrows: false,
        Toolbar: {
          display: {
            left: [],
            middle: [],
            right: ["close"],
          },
        },
        transition: "slide",
      },
    });
  </script>

  <style>
    main {
      --padding: max(2.5vw, 12px);
      padding: var(--padding);
    }

    .justified-gallery {
      --space: clamp(12px, 1.25vw, 6px);
      --min-height: clamp(200px, 20vw, 400px);

      display: flex;
      flex-wrap: wrap;
      gap: var(--space);

      a {
        flex-grow: calc(var(--width) * (100000 / var(--height)));
        flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
        aspect-ratio: var(--width) / var(--height);
        overflow: hidden;
        opacity: 1;
        transition: all 0.05s ease-in-out;
      }

      a img {
        display: block;
        object-fit: cover;
        height: 100%;
        width: 100%;
      }

      a:focus-visible {
        outline: 3px solid var(--outline);
        outline-offset: 2px;
        transform: scale(1.05);
        z-index: 1;
        border-radius: 2px;
        box-shadow: 0 2px 4px 2px rgba(0, 0, 0, 0.1);
      }

      a.hidden {
        transition: opacity 0.4s ease-in-out;
        opacity: 0;
      }

      &::after {
        content: " ";
        flex-grow: 1000000000;
      }
    }
  </style>
</BaseLayout>
