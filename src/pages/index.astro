---
export const prerender = false;

import { preview } from "astro";
import { getCollection } from "astro:content";
import MyImage from "~/components/MyImage.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { R2CollectionClient } from "~/lib/r2CollectionClient";

let galleries = await getCollection("galleries");
console.log("gallery count: ", galleries.length);

const isDev = Astro.url.searchParams.get("isDev");

if (isDev === null) {
  galleries = galleries.filter((g) => g.id !== "example");
}

const client = new R2CollectionClient(Astro.locals.runtime.env.gallery_images, {
  accountId: Astro.locals.runtime.env.R2_ACCOUNT_ID as string,
  bucketName: Astro.locals.runtime.env.R2_BUCKET_NAME as string,
  accessKeyId: Astro.locals.runtime.env.R2_ACCESS_KEY_ID as string,
  secretAccessKey: Astro.locals.runtime.env.R2_SECRET_ACCESS_KEY as string,
  publicUrl: Astro.locals.runtime.env.R2_PUBLIC_URL,
});

const previewImageBlurhash: Record<string, string> = {};

const promises = galleries.map(async (gallery) => {
  const image = await client.getImageMetadata(gallery.data.previewImg);
  previewImageBlurhash[gallery.id] = image.blurhash;
});

await Promise.all(promises);
---

<BaseLayout>
  <ul id="galleries">
    {
      galleries.map(async (gallery) => {
        return (
          <li class="gallery">
            {gallery.data.name && (
              <a href={gallery.data.link}>
                <h2 style="font-family: Unbounded; margin: 0; font-size: 1.5rem;">
                  {gallery.data.name}
                </h2>
                <span>
                  <MyImage
                    src={gallery.data.previewImg}
                    key={gallery.data.name + " preview"}
                    width={400}
                    height={300}
                    blurhash={previewImageBlurhash[gallery.id]}
                  />
                </span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</BaseLayout>

<style>
  ul#galleries {
    display: grid;
    grid-template-columns: 1fr;
    flex-direction: column;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: max(2.5vw, 12px);
    gap: max(2.5vw, 12px);
  }

  li.gallery {
    display: grid;
    grid-template-columns: 1fr;

    align-items: center;

    & a {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: inherit;
      text-transform: capitalize;
    }

    & span {
      aspect-ratio: 4 / 3;
      height: 100%;
      width: 100%;
    }

    & img {
      aspect-ratio: 4 / 3;
      height: 100%;
      width: 100%;
      /* background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><rect width='100' height='100' fill='red'/></svg>"); */
    }
  }

  @media screen and (min-width: 400px) {
    ul#galleries {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 650px) {
    ul#galleries {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
