---
// src/pages/upload.astro
import { generateBlurhashFromArrayBuffer } from "~/lib/getBlurhash";

let message = "";
let messageType = "info";

// --- Server Side Logic ---
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    // 1. Get the Original File (for R2)
    const originalFile = formData.get("file") as File;

    // 2. Get the "Tiny" File (specifically for Blurhash generation)
    const tinyFile = formData.get("tiny_file") as File;

    const slug = formData.get("slug") as string;
    const group = formData.get("group") as string;

    // Dimensions calculated by client
    const widthRaw = formData.get("width") as string;
    const heightRaw = formData.get("height") as string;

    if (!originalFile || !slug) {
      throw new Error("Missing file or collection slug.");
    }

    // --- Generate Blurhash (Fast) ---
    // We use the tiny file if available, otherwise fall back to original (slow)
    const fileForBlurhash = tinyFile || originalFile;
    const blurhashBuffer = await fileForBlurhash.arrayBuffer();

    // This will now run much faster because the buffer is small (~10kb vs 5MB)
    const blurhash = await generateBlurhashFromArrayBuffer(blurhashBuffer);

    // --- Prepare Filename ---
    let fileName = originalFile.name;
    if (group && group.trim() !== "") {
      const parts = fileName.split(".");
      const ext = parts.pop();
      const base = parts.join(".");
      fileName = `${base}_${group}_.${ext}`;
    }
    const objectKey = `${slug}/${fileName}`;

    // --- Upload to R2 ---
    // Using your specific bucket binding
    const bucket = Astro.locals.runtime.env.gallery_images as R2Bucket;

    if (!bucket) {
      throw new Error("R2 Bucket 'gallery_images' not found in env.");
    }

    // We upload the ORIGINAL huge file to R2, but attach the efficient metadata
    await bucket.put(objectKey, await originalFile.arrayBuffer(), {
      httpMetadata: {
        contentType: originalFile.type,
      },
      customMetadata: {
        width: widthRaw,
        height: heightRaw,
        blurhash: blurhash,
      },
    });

    message = `Successfully uploaded: ${objectKey}`;
    messageType = "success";
  } catch (error) {
    console.error(error);
    message =
      error instanceof Error ? error.message : "An unknown error occurred";
    messageType = "error";
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>R2 Image Uploader</title>
  </head>
  <body>
    <main class="container">
      <h1>Upload to Collection</h1>

      <p class="subtitle">
        Client-side resizing speeds up server-side Blurhash generation.
      </p>

      {message && <div class={`alert ${messageType}`}>{message}</div>}

      <form id="uploadForm">
        <div class="form-group">
          <label for="slug">Collection Slug</label>
          <input
            type="text"
            id="slug"
            name="slug"
            placeholder="e.g. vacation-2024"
            required
          />
        </div>

        <div class="form-group">
          <label for="group">Group Name</label>
          <input
            type="text"
            id="group"
            name="group"
            placeholder="e.g. details"
          />
        </div>

        <div class="form-group">
          <label for="file">Select Image</label>
          <input type="file" id="file" name="file" accept="image/*" required />
        </div>

        <div id="preview-container" style="display:none;">
          <p>Preview:</p>
          <img id="preview-img" />
          <p id="dims-display"></p>
        </div>

        <button type="submit" id="submitBtn">Upload Image</button>
        <p
          id="loading-text"
          style="display:none; text-align:center; color:#666;"
        >
          Processing & Uploading...
        </p>
      </form>
    </main>

    <script>
      const form = document.getElementById("uploadForm") as HTMLFormElement;
      const fileInput = document.getElementById("file") as HTMLInputElement;
      const previewContainer = document.getElementById("preview-container");
      const previewImg = document.getElementById(
        "preview-img"
      ) as HTMLImageElement;
      const dimsDisplay = document.getElementById("dims-display");
      const submitBtn = document.getElementById(
        "submitBtn"
      ) as HTMLButtonElement;
      const loadingText = document.getElementById("loading-text");

      let tinyBlob: Blob | null = null;
      let originalWidth = 0;
      let originalHeight = 0;

      // 1. Preview and Resize Logic
      fileInput?.addEventListener("change", (event) => {
        const file = (event.target as HTMLInputElement).files?.[0];

        if (file) {
          const objectUrl = URL.createObjectURL(file);
          previewImg.onload = () => {
            // A. Capture Original Dimensions
            originalWidth = previewImg.naturalWidth;
            originalHeight = previewImg.naturalHeight;

            // B. Create Tiny Version (Max 100px) for Blurhash
            const canvas = document.createElement("canvas");
            const MAX_SIZE = 100;
            let scale = 1;

            if (originalWidth > MAX_SIZE || originalHeight > MAX_SIZE) {
              scale = Math.min(
                MAX_SIZE / originalWidth,
                MAX_SIZE / originalHeight
              );
            }

            canvas.width = originalWidth * scale;
            canvas.height = originalHeight * scale;

            const ctx = canvas.getContext("2d");
            if (ctx) {
              ctx.drawImage(previewImg, 0, 0, canvas.width, canvas.height);
              // Convert canvas to blob (tiny image)
              canvas.toBlob(
                (blob) => {
                  tinyBlob = blob;
                },
                "image/jpeg",
                0.7
              );
            }

            // UI Updates
            if (dimsDisplay)
              dimsDisplay.textContent = `${originalWidth}px x ${originalHeight}px`;
            if (previewContainer) previewContainer.style.display = "block";

            URL.revokeObjectURL(objectUrl);
          };
          previewImg.src = objectUrl;
        }
      });

      // 2. Intercept Submit to send Data
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!fileInput.files || fileInput.files.length === 0) return;

        // UI State: Loading
        submitBtn.disabled = true;
        submitBtn.style.opacity = "0.5";
        if (loadingText) loadingText.style.display = "block";

        try {
          const formData = new FormData(form);

          // Add the dimensions we calculated
          formData.set("width", originalWidth.toString());
          formData.set("height", originalHeight.toString());

          // Add the tiny blob for the server to generate Blurhash quickly
          if (tinyBlob) {
            formData.set("tiny_file", tinyBlob, "tiny_preview.jpg");
          }

          // Perform the upload via fetch to keep control
          const response = await fetch(window.location.href, {
            method: "POST",
            body: formData,
          });

          // Reload page to show server response (success/error banner)
          // Or handle manually, but reloading mimics standard form behavior
          const html = await response.text();
          document.open();
          document.write(html);
          document.close();
        } catch (err) {
          console.error(err);
          alert("Upload failed.");
          submitBtn.disabled = false;
          if (loadingText) loadingText.style.display = "none";
        }
      });
    </script>

    <style>
      /* --- Styles --- */
      :root {
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --bg: #f8fafc;
        --surface: #ffffff;
        --text: #1e293b;
        --border: #e2e8f0;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        display: flex;
        justify-content: center;
        padding-top: 50px;
        margin: 0;
      }

      .container {
        background-color: var(--surface);
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 500px;
      }

      h1 {
        margin-top: 0;
        margin-bottom: 0.5rem;
      }
      .subtitle {
        color: #64748b;
        margin-bottom: 2rem;
        font-size: 0.9rem;
      }
      .form-group {
        margin-bottom: 1.5rem;
      }

      label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
      }

      input[type="text"],
      input[type="file"] {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 1rem;
      }

      button {
        background-color: var(--primary);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        font-size: 1rem;
      }
      button:hover {
        background-color: var(--primary-hover);
      }

      .alert {
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
      }
      .alert.error {
        background-color: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }
      .alert.success {
        background-color: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
      }

      #preview-container {
        margin-bottom: 1.5rem;
        padding: 1rem;
        border: 1px dashed var(--border);
        border-radius: 6px;
        text-align: center;
      }
      #preview-img {
        max-width: 100%;
        max-height: 200px;
        display: block;
        margin: 0 auto;
      }
    </style>
  </body>
</html>
