---
import { Image } from "@unpic/astro";
import { blurhashToCssGradientString } from "@unpic/placeholder";
import type { GalleryImage } from "~/content/config";
import { getBlurhashFromBucket } from "~/lib/getBlurhash";

type Props = GalleryImage;

const { src, key, width, height, blurhash }: Props = Astro.props;

let cssGradient;
if (blurhash) {
  cssGradient = blurhashToCssGradientString(blurhash);
}
// if (blurhash === undefined || blurhash === "") {
//   const bucket = Astro.locals.runtime.env.gallery_images;

//   blurhash = await getBlurhashFromBucket(bucket, key);
// }
---

<Image
  src={src}
  alt={key}
  width={width}
  height={height}
  background={cssGradient}
  options={{
    cloudflare: {
      domain: "image-assets.samfelton.com",
    },
  }}
/>
