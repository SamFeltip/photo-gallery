---
import { Image } from "@unpic/astro";
import { getBlurhash } from "~/lib/getBlurhash";

type Props = {
  src: string;
  alt: string;
  width: number;
  height: number;
};

const { src, alt, width, height }: Props = Astro.props;

const gimgs = Astro.locals.runtime.env.GALLERY_HASHMAPS;

let blurhash;
let error;
try {
  blurhash = await getBlurhash(gimgs, src);
} catch (e) {
  console.error("Error getting blurhash for ", src, e);
  error = (e as Error).message;
}
---

{error && <p>{error}</p>}
<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  background={blurhash}
  options={{
    cloudflare: {
      domain: "image-assets.samfelton.com",
    },
  }}
/>
