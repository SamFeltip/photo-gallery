---
import { Image } from "@unpic/astro";
import { getBlurhash, getBlurhashFromBucket } from "~/lib/getBlurhash";
import { GET } from "~/pages/blurhash/[id]";

type Props = {
  src: string;
  alt: string;
  width: number;
  height: number;
};

const { src, alt, width, height }: Props = Astro.props;

const gimgs = Astro.locals.runtime.env.gallery_images;

// const blurhash = await getBlurhashFromBucket(gimgs, src);
const blurhash = await getBlurhash(src);
---

<Image
  src={"/images/" + src}
  alt={alt}
  width={width}
  height={height}
  background={blurhash}
  options={{
    cloudflare: {
      domain: "photos.samfelton.com",
    },
  }}
/>
